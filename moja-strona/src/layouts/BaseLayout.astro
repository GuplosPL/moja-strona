---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface NavLink { href: string; i18nKey: string; label: string; }

interface Props {
    title: string;
    description: string;
    ogTitle?: string;
    ogDescription?: string;
    ogUrl?: string;
    canonicalUrl?: string;
    navLinks?: NavLink[];
    logoHref?: string;
    logoTarget?: string;
    showVisits?: boolean;
    showStatusLink?: boolean;
    activeNav?: string;
    revealHero?: boolean;
}

const {
    title,
    description,
    ogTitle = title,
    ogDescription = description,
    ogUrl = 'https://guplospl.com',
    canonicalUrl = ogUrl,
    navLinks = [],
    logoHref = '/',
    logoTarget = '_self',
    showVisits = false,
    showStatusLink = false,
    activeNav = '',
    revealHero = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="pl">
<head>
    <script is:inline>var t=null;try{t=localStorage.getItem('theme')}catch(e){};document.documentElement.setAttribute('data-theme',(t==='dark'||t==='oled')?t:'oled');</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Guplos PL",
        "url": "https://guplospl.com",
        "description": "Portfolio Guplos PL – virtual photographer, cinematographer & editor.",
        "author": {
            "@type": "Person",
            "name": "Guplos PL",
            "url": "https://guplospl.com",
            "sameAs": [
                "https://www.instagram.com/guplos_pl/",
                "https://www.tiktok.com/@guplospl",
                "https://open.spotify.com/user/pkpmztdpnxtrt75rgf7xj4dit",
                "https://steamcommunity.com/id/guplospl/",
                "https://discord.com/users/751089335998218440"
            ]
        }
    }
    </script>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={ogUrl}>
    <meta property="og:image" content="https://guplospl.com/tlo.webp">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    <meta name="twitter:image" content="https://guplospl.com/tlo.webp">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='45' fill='%235865F2'/><text x='50' y='50' dominant-baseline='central' text-anchor='middle' font-size='55' font-weight='bold' fill='white' font-family='sans-serif'>G</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script is:inline src="/tsparticles.bundle.min.js" defer></script>
    <script is:inline>history.scrollRestoration='manual'</script>
</head>
<body class="font-['Inter'] antialiased min-h-screen flex flex-col" data-reveal-hero={revealHero} style="color: var(--text); background: var(--bg);">
    <div id="progress-bar" class="fixed top-0 left-0 w-0 h-[2px] z-[100] bg-[#5865F2]" style="transition: width 50ms linear; box-shadow: 0 0 8px rgba(88,101,242,0.5);"></div>
    <div id="particles-js" class="fixed inset-0 z-0 pointer-events-none"></div>

    <div class="fixed inset-0 z-0 pointer-events-none" style="background: radial-gradient(1100px 700px at 100% -10%, rgba(88,101,242,0.14), transparent 60%), radial-gradient(900px 600px at -10% 110%, rgba(88,101,242,0.08), transparent 60%), radial-gradient(800px 600px at 35% 100%, rgba(139,92,246,0.07), transparent 60%), radial-gradient(900px 700px at 110% 45%, rgba(139,92,246,0.06), transparent 60%), radial-gradient(700px 500px at 30% -5%, rgba(88,101,242,0.06), transparent 60%), radial-gradient(700px 500px at 70% 110%, rgba(168,85,247,0.05), transparent 60%);"></div>

    <Nav links={navLinks} logoHref={logoHref} logoTarget={logoTarget} active={activeNav} />

    <div class="page-reveal relative z-10 flex-1 flex flex-col">
        <slot />
        <Footer visits={showVisits} statusLink={showStatusLink} />
    </div>

    <CookieBanner />

    <script>
        import { initTheme } from '../lib/theme.js';
        import { initNav } from '../lib/nav.js';
        import { initLang } from '../lib/i18n.js';
        import { initProgressBar, initReveal } from '../lib/scroll.js';
        import { initEffects } from '../lib/effects.js';

        initTheme();
        initNav();
        initLang();
        initProgressBar();
        initReveal({ hero: document.body.dataset.revealHero === 'true' });
        initEffects();
        const yearEl = document.getElementById('year');
        if (yearEl) yearEl.textContent = new Date().getFullYear();
    </script>
</body>
</html>
