---
interface NavLink { href: string; i18nKey: string; label: string; key?: string; }
interface Props { links: NavLink[]; logoHref?: string; logoTarget?: string; active?: string; }
const { links, logoHref = '/', logoTarget = '_self', active = '' } = Astro.props;
---
<nav class="fixed top-0 w-full z-50 border-b" style="background: var(--bg-elev); border-color: var(--card-border);">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href={logoHref} target={logoTarget} class="font-extrabold text-lg tracking-tight no-underline" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3), 0 0 60px rgba(255,255,255,0.15);">#GOODDAYS</a>
        <div class="hidden md:flex items-center gap-2">
            {links.map(link => (
                <Fragment>
                    <a href={link.href} class:list={['px-4 py-2 text-sm font-medium nav-link', { active: active === (link.key ?? link.i18nKey) }]} data-i18n={link.i18nKey}>{link.label}</a>
                    {link.i18nKey === 'nav-gallery' && (
                        <div class="relative">
                            <button id="tools-btn" class:list={['px-4 py-2 text-sm font-medium nav-link flex items-center gap-1', { active: active === 'tools' }]}>Narzędzia<svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" class="transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg></button>
                            <div id="tools-menu" class="hidden absolute top-full left-0 mt-2 z-[60] w-56 p-2 rounded-xl border" style="background: var(--bg-elev); border-color: var(--card-border);">
                                <a href="/narzedzia/kolory-producentow" class:list={['block px-3 py-2 text-sm rounded-lg nav-link', { active: active === 'tools' }]} data-i18n="tools-colors">Kolory Producentów</a>
                                <a href="/narzedzia/edytor-obrazow" class:list={['block px-3 py-2 text-sm rounded-lg nav-link', { active: active === 'tools' }]} data-i18n="tools-editor">Edytor Obrazów</a>
                                <div class="px-3 pt-2 pb-1 text-xs font-medium" style="color: var(--muted);" data-i18n="tools-more-soon">Więcej wkrótce...</div>
                            </div>
                        </div>
                    )}
                </Fragment>
            ))}
            <div class="relative">
                <button id="theme-btn" class="w-9 h-9 rounded-full flex items-center justify-center icon-btn transition-all" title="Theme">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M19.8 4.2l-2.1 2.1M6.3 17.7l-2.1 2.1"/></svg>
                </button>
                <div id="theme-menu" class="hidden absolute top-full right-0 mt-2 z-[60] w-40 p-2 rounded-xl border" style="background: var(--bg-elev); border-color: var(--card-border);">
                    <button data-theme-opt="oled" class="theme-opt w-full px-3 py-2 text-sm text-left rounded-lg flex items-center justify-between"><span>OLED</span><span class="theme-check hidden text-[#5865F2]">✓</span></button>
                    <button data-theme-opt="dark" class="theme-opt w-full px-3 py-2 text-sm text-left rounded-lg flex items-center justify-between"><span data-i18n="theme-dark">Czarny</span><span class="theme-check hidden text-[#5865F2]">✓</span></button>
                </div>
            </div>
            <button id="lang-toggle" class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold icon-btn transition-all" style="text-shadow: 0 0 8px rgba(255,255,255,0.2);">EN</button>
        </div>
        <div class="flex items-center gap-2 md:hidden">
            <div class="relative">
                <button id="theme-btn-mobile" class="w-11 h-11 rounded-full flex items-center justify-center icon-btn transition-all" title="Theme">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M19.8 4.2l-2.1 2.1M6.3 17.7l-2.1 2.1"/></svg>
                </button>
                <div id="theme-menu-mobile" class="hidden absolute top-full right-0 mt-2 z-[60] w-40 p-2 rounded-xl border" style="background: var(--bg-elev); border-color: var(--card-border);">
                    <button data-theme-opt="oled" class="theme-opt w-full px-3 py-2 text-sm text-left rounded-lg flex items-center justify-between"><span>OLED</span><span class="theme-check hidden text-[#5865F2]">✓</span></button>
                    <button data-theme-opt="dark" class="theme-opt w-full px-3 py-2 text-sm text-left rounded-lg flex items-center justify-between"><span data-i18n="theme-dark">Czarny</span><span class="theme-check hidden text-[#5865F2]">✓</span></button>
                </div>
            </div>
            <button id="lang-toggle-mobile" class="w-11 h-11 rounded-full flex items-center justify-center text-xs font-bold icon-btn transition-all" style="text-shadow: 0 0 8px rgba(255,255,255,0.2);">EN</button>
            <button id="menu-btn" class="w-11 h-11 rounded-full flex flex-col items-center justify-center gap-[6px] icon-btn transition-all" aria-label="Menu">
                <span class="menu-line block w-5 h-[2px] bg-current rounded-full transition-all"></span>
                <span class="menu-line block w-5 h-[2px] bg-current rounded-full transition-all"></span>
                <span class="menu-line block w-5 h-[2px] bg-current rounded-full transition-all"></span>
            </button>
        </div>
    </div>
    <div class="md:hidden">
        <div class="mobile-menu-wrap grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out border-t" style="background: var(--bg-elev); border-color: var(--card-border);">
            <div class="overflow-hidden">
                <div class="flex flex-col items-center gap-1 px-6 py-4">
                    {links.map(link => (
                        <Fragment>
                            <a href={link.href} class:list={['w-full py-4 text-sm font-medium nav-item-mobile rounded-lg text-center', { active: active === (link.key ?? link.i18nKey) }]} data-i18n={link.i18nKey}>{link.label}</a>
                            {link.i18nKey === 'nav-gallery' && (
                                <a href="/narzedzia/kolory-producentow" class:list={['w-full py-4 text-sm font-medium nav-item-mobile rounded-lg text-center', { active: active === 'tools' }]} data-i18n="tools-colors">Kolory Producentów</a>
                                <a href="/narzedzia/edytor-obrazow" class:list={['w-full py-4 text-sm font-medium nav-item-mobile rounded-lg text-center', { active: active === 'tools' }]} data-i18n="tools-editor">Edytor Obrazów</a>
                                <div class="w-full py-4 text-sm font-medium text-center" style="color: var(--muted);" data-i18n="tools-more-soon">Więcej wkrótce...</div>
                            )}
                        </Fragment>
                    ))}
                </div>
            </div>
        </div>
    </div>
</nav>
