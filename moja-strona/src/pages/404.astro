---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="pl">
<head>
    <script is:inline>var t=null;try{t=localStorage.getItem('theme')}catch(e){};document.documentElement.setAttribute('data-theme',(t==='dark'||t==='oled')?t:'oled');</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 – Guplos PL</title>
    <meta name="description" content="Strona nie została znaleziona.">
    <meta property="og:title" content="404 – Guplos PL">
    <meta property="og:description" content="Strona nie została znaleziona.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://moja-strona-yi0.pages.dev">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='45' fill='%235865F2'/><text x='50' y='50' dominant-baseline='central' text-anchor='middle' font-size='55' font-weight='bold' fill='white' font-family='sans-serif'>G</text></svg>">
    <style is:global>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root { --bg: #000000; --text: #e0e0e0; --muted: #888888; --text-bright: #ffffff; color-scheme: dark; }
        [data-theme="dark"] { --bg: #111214; --text: #dbdee1; --muted: #949ba4; --text-bright: #ffffff; }
        [data-theme="oled"] { --bg: #000000; --text: #e0e0e0; --muted: #888888; --text-bright: #ffffff; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; }
        .glow { text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3), 0 0 60px rgba(255,255,255,0.15); }
        .btn { display: inline-block; margin-top: 2rem; padding: 0.75rem 2rem; background: #5865F2; color: white; text-decoration: none; font-weight: 600; font-size: 0.9rem; border-radius: 999px; transition: background 0.2s; }
        .btn:hover { background: #4752C4; }
    </style>
</head>
<body>
    <h1 class="glow" style="font-size: 7rem; font-weight: 900; color: var(--text-bright); line-height: 1;">404</h1>
    <p id="msg" style="font-size: 1.2rem; color: var(--muted); margin-top: 0.5rem;">Strona nie została znaleziona</p>
    <a id="btn" href="/" class="btn">Wróć do strony głównej</a>
    <script is:inline>
        const lang = (function(){try{return localStorage.getItem('lang')}catch(e){return null}})() || (navigator.language.startsWith('pl') ? 'pl' : 'en');
        if (lang !== 'pl') {
            document.getElementById('msg').textContent = 'Page not found';
            document.getElementById('btn').textContent = 'Back to homepage';
        }
    </script>
</body>
</html>
