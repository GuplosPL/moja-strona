---
import BaseLayout from '../layouts/BaseLayout.astro';

const navLinks = [
    { href: '/', i18nKey: 'nav-home', label: 'Strona główna' },
    { href: '/#gallery', i18nKey: 'nav-gallery', label: 'Galeria' },
    { href: '/wspolprace', i18nKey: 'nav-collabs', label: 'Współprace', key: 'collabs' },
    { href: '/faq', i18nKey: 'nav-faq', label: 'FAQ' },
];
---
<BaseLayout
    title="Współprace – Guplos PL"
    description="Projekty i współprace Guplos PL."
    ogUrl="https://moja-strona-yi0.pages.dev/wspolprace"
    navLinks={navLinks}
    activeNav="collabs"
>
    <section class="flex-1 max-w-3xl mx-auto px-6 pt-32 pb-16 w-full">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-center mb-3 fade-in" data-i18n="collabs-title" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3), 0 0 60px rgba(255,255,255,0.15);">Współprace</h1>
        <p class="text-center mb-12 fade-in" data-i18n="collabs-sub" style="color: var(--muted);">Projekty i współprace</p>

        <div class="p-8 rounded-2xl border fade-in relative overflow-hidden mb-8" style="background: linear-gradient(135deg, rgba(88,101,242,0.12), var(--card) 55%); border-color: var(--card-border);">
            <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full blur-3xl" style="background: rgba(88,101,242,0.25);"></div>
            <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 overflow-hidden" style="background: var(--card); box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.35);">
                    <img src="/instantgaming.png" alt="Instant Gaming" class="w-full h-full object-contain p-1.5">
                </div>
                <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest mb-1 bg-[#5865F2]/15 text-[#5865F2]" data-i18n="ig-badge">Partner</span>
                    <h2 class="text-2xl font-black tracking-tight leading-none" data-i18n="ig-title" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.4), 0 0 30px rgba(255,255,255,0.15);">Instant Gaming</h2>
                </div>
            </div>

            <p class="text-sm leading-relaxed mb-6" data-i18n="ig-desc" style="color: var(--muted);">Kupuję i polecam gry w dobrej cenie. Korzystając z mojego linku wspierasz moją twórczość bez dopłacania niczego — to nic Cię nie kosztuje, a pomaga mi w tworzeniu lepszych treści!</p>

            <p class="text-xs font-bold uppercase tracking-widest mb-3" data-i18n="ig-benefits" style="color: var(--text-bright);">Dlaczego warto?</p>
            <ul class="space-y-2.5 mb-8">
                <li class="flex items-start gap-3 text-sm">
                    <span class="w-5 h-5 rounded-full bg-[#5865F2] text-white flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span data-i18n="ig-b1" style="color: var(--text);">Legalne klucze w atrakcyjnych cenach</span>
                </li>
                <li class="flex items-start gap-3 text-sm">
                    <span class="w-5 h-5 rounded-full bg-[#5865F2] text-white flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span data-i18n="ig-b2" style="color: var(--text);">Szeroki wybór gier i DLC</span>
                </li>
                <li class="flex items-start gap-3 text-sm">
                    <span class="w-5 h-5 rounded-full bg-[#5865F2] text-white flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span data-i18n="ig-b3" style="color: var(--text);">Wspierasz mnie zupełnie za darmo</span>
                </li>
            </ul>

            <a href="https://www.instant-gaming.com/en/?igr=guplospl" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm rounded-full transition-colors no-underline">
                <span data-i18n="ig-cta">Sprawdź gry na Instant Gaming</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9"/></svg>
            </a>
        </div>

        <div class="p-8 rounded-2xl border fade-in text-center" style="background: var(--card); border-color: var(--card-border);">
            <p class="text-sm leading-relaxed" data-i18n="collabs-desc" style="color: var(--muted);">Sekcja w przygotowaniu — wkrótce pojawią się tutaj informacje o moich projektach i współpracach.</p>
        </div>
    </section>
</BaseLayout>
