---
import BaseLayout from '../layouts/BaseLayout.astro';

const navLinks = [
    { href: '/', i18nKey: 'nav-home', label: 'Strona główna' },
    { href: '/#gallery', i18nKey: 'nav-gallery', label: 'Galeria' },
    { href: '/wspolprace', i18nKey: 'nav-collabs', label: 'Współprace', key: 'collabs' },
    { href: '/faq', i18nKey: 'nav-faq', label: 'FAQ' },
];
---
<BaseLayout
    title="Współprace – Guplos PL"
    description="Projekty i współprace Guplos PL."
    ogUrl="https://guplospl.com/wspolprace"
    navLinks={navLinks}
    activeNav="collabs"
>
    <section class="flex-1 max-w-3xl mx-auto px-6 pt-32 pb-16 w-full">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-center mb-3 fade-in" data-i18n="collabs-title" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3), 0 0 60px rgba(255,255,255,0.15);">Współprace</h1>
        <p class="text-center mb-12 fade-in" data-i18n="collabs-sub" style="color: var(--muted);">Projekty i współprace</p>

        <div class="p-8 rounded-2xl border fade-in relative overflow-hidden mb-8" style="background: linear-gradient(135deg, rgba(88,101,242,0.25), var(--card) 55%); border-color: rgba(88,101,242,0.45); box-shadow: 0 0 40px rgba(88,101,242,0.12);">
            <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full blur-3xl" style="background: rgba(88,101,242,0.35);"></div>
            <div class="absolute -bottom-20 -left-20 w-56 h-56 rounded-full blur-3xl" style="background: rgba(88,101,242,0.2);"></div>
            <div class="absolute top-0 left-0 w-full h-1.5" style="background: linear-gradient(90deg, #5865F2, #9b8cff, #5865F2);"></div>
            <div class="flex items-center gap-4 mb-6">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center shrink-0 overflow-hidden" style="background: var(--card); box-shadow: 0 0 0 2px rgba(88,101,242,0.6), 0 0 24px rgba(88,101,242,0.35), 0 8px 24px rgba(0,0,0,0.35);">
                    <img src="/wumpus.png" alt="Wumpus Central" class="w-full h-full object-cover">
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2 flex-wrap mb-1">
                        <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest bg-[#5865F2] text-white" data-i18n="wumpus-badge">Serwer Discord</span>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest text-white" style="background: linear-gradient(90deg, #f59e0b, #ef4444);">★ <span data-i18n="wumpus-featured">Wyróżnione</span></span>
                    </div>
                    <h2 class="text-2xl font-black tracking-tight leading-none" data-i18n="wumpus-title" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.4), 0 0 30px rgba(255,255,255,0.15);">Wumpus Central</h2>
                </div>
            </div>

            <p class="text-sm leading-relaxed mb-6" data-i18n="wumpus-desc" style="color: var(--muted);">Społeczność Discord poświęcona Wumpusowi — najsłodszemu maskotce Discorda. Dołącz, poznaj ludzi i wspieraj Wumpusa razem z nami!</p>

            <div class="flex flex-wrap gap-3">
                <a href="https://discord.wumpus.tools/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm rounded-full transition-colors no-underline">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                    <span data-i18n="wumpus-join">Dołącz do serwera</span>
                </a>
                <a href="https://github.com/Wumpus-Central" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 text-white font-semibold text-sm rounded-full transition-colors no-underline" style="background: #24292f;" onmouseenter="this.style.background='#1b1f23'" onmouseleave="this.style.background='#24292f'">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                    <span data-i18n="wumpus-github">GitHub</span>
                </a>
                <a href="https://x.com/WumpusCentral" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 text-white font-semibold text-sm rounded-full transition-colors no-underline" style="background: #000;" onmouseenter="this.style.background='#161616'" onmouseleave="this.style.background='#000'">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    <span data-i18n="wumpus-x">X (Twitter)</span>
                </a>
            </div>
        </div>

        <div class="p-8 rounded-2xl border fade-in relative overflow-hidden mb-8" style="background: linear-gradient(135deg, rgba(88,101,242,0.12), var(--card) 55%); border-color: var(--card-border);">
            <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full blur-3xl" style="background: rgba(88,101,242,0.25);"></div>
            <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 overflow-hidden" style="background: var(--card); box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.35);">
                    <img src="/instantgaming.png" alt="Instant Gaming" class="w-full h-full object-cover">
                </div>
                <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest mb-1 bg-[#5865F2]/15 text-[#5865F2]" data-i18n="ig-badge">Partner</span>
                    <h2 class="text-2xl font-black tracking-tight leading-none" data-i18n="ig-title" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.4), 0 0 30px rgba(255,255,255,0.15);">Instant Gaming</h2>
                </div>
            </div>

            <p class="text-sm leading-relaxed mb-6" data-i18n="ig-desc" style="color: var(--muted);">Kupuję i polecam gry w dobrej cenie. Korzystając z mojego linku wspierasz moją twórczość bez dopłacania niczego — to nic Cię nie kosztuje, a pomaga mi w tworzeniu lepszych treści!</p>

            <p class="text-xs font-bold uppercase tracking-widest mb-3" data-i18n="ig-benefits" style="color: var(--text-bright);">Dlaczego warto?</p>
            <ul class="space-y-2.5 mb-8">
                <li class="flex items-start gap-3 text-sm">
                    <span class="w-5 h-5 rounded-full bg-[#5865F2] text-white flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span data-i18n="ig-b1" style="color: var(--text);">Legalne klucze w atrakcyjnych cenach</span>
                </li>
                <li class="flex items-start gap-3 text-sm">
                    <span class="w-5 h-5 rounded-full bg-[#5865F2] text-white flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span data-i18n="ig-b2" style="color: var(--text);">Szeroki wybór gier i DLC</span>
                </li>
                <li class="flex items-start gap-3 text-sm">
                    <span class="w-5 h-5 rounded-full bg-[#5865F2] text-white flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span data-i18n="ig-b3" style="color: var(--text);">Wspierasz mnie zupełnie za darmo</span>
                </li>
            </ul>

            <a href="https://www.instant-gaming.com/en/?igr=guplospl" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm rounded-full transition-colors no-underline">
                <span data-i18n="ig-cta">Sprawdź gry na Instant Gaming</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9"/></svg>
            </a>
        </div>

        <div class="p-8 rounded-2xl border fade-in text-center" style="background: var(--card); border-color: var(--card-border);">
            <p class="text-sm leading-relaxed" data-i18n="collabs-desc" style="color: var(--muted);">Sekcja w przygotowaniu — wkrótce pojawią się tutaj informacje o moich projektach i współpracach.</p>
        </div>
    </section>
</BaseLayout>
