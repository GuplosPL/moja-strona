---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface NavLink { href: string; i18nKey: string; label: string; }

interface Props {
    title: string;
    description: string;
    ogTitle?: string;
    ogDescription?: string;
    ogUrl?: string;
    navLinks?: NavLink[];
    logoHref?: string;
    logoTarget?: string;
    showVisits?: boolean;
    showStatusLink?: boolean;
    activeNav?: string;
    revealHero?: boolean;
}

const {
    title,
    description,
    ogTitle = title,
    ogDescription = description,
    ogUrl = 'https://moja-strona-yi0.pages.dev',
    navLinks = [],
    logoHref = '/',
    logoTarget = '_self',
    showVisits = false,
    showStatusLink = false,
    activeNav = '',
    revealHero = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="pl">
<head>
    <script is:inline>var t=null;try{t=localStorage.getItem('theme')}catch(e){};document.documentElement.setAttribute('data-theme',(t==='dark'||t==='oled')?t:'oled');</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={ogUrl}>
    <meta property="og:image" content="https://moja-strona-yi0.pages.dev/tlo.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    <meta name="twitter:image" content="https://moja-strona-yi0.pages.dev/tlo.png">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='45' fill='%235865F2'/><text x='50' y='50' dominant-baseline='central' text-anchor='middle' font-size='55' font-weight='bold' fill='white' font-family='sans-serif'>G</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script is:inline>history.scrollRestoration='manual'</script>
</head>
<body class="font-['Inter'] antialiased min-h-screen flex flex-col" style="color: var(--text); background: var(--bg);">
    <div id="progress-bar" class="fixed top-0 left-0 w-0 h-[2px] z-[100] bg-[#5865F2]" style="transition: width 50ms linear; box-shadow: 0 0 8px rgba(88,101,242,0.5);"></div>
    <div id="particles-js" class="fixed inset-0 z-0 pointer-events-none"></div>

    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-60 -right-40 w-[600px] h-[600px] rounded-full bg-[#5865F2]/15 blur-[120px]"></div>
        <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] rounded-full bg-[#5865F2]/8 blur-[100px]"></div>
    </div>

    <Nav links={navLinks} logoHref={logoHref} logoTarget={logoTarget} active={activeNav} />

    <div class="page-reveal relative z-10 flex-1 flex flex-col">
        <slot />
        <Footer visits={showVisits} statusLink={showStatusLink} />
    </div>

    <script is:inline src="/tsparticles.bundle.min.js"></script>
    <script>
        import { initTheme, setOnThemeChange } from '../lib/theme.js';
        import { initNav } from '../lib/nav.js';
        import { initLang } from '../lib/i18n.js';
        import { initProgressBar, initReveal } from '../lib/scroll.js';
        import { initEffects, initParticles } from '../lib/effects.js';

        initTheme();
        initNav();
        initLang();
        initProgressBar();
        initReveal({ hero: {revealHero} });
        initEffects();
        setOnThemeChange(() => { if (!window.matchMedia('(hover: none), (pointer: coarse)').matches) initParticles(); });
        const yearEl = document.getElementById('year');
        if (yearEl) yearEl.textContent = new Date().getFullYear();
    </script>
</body>
</html>
