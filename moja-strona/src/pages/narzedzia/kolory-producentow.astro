---
import BaseLayout from '../../layouts/BaseLayout.astro';

const navLinks = [
    { href: '/', i18nKey: 'nav-home', label: 'Strona główna' },
    { href: '/#gallery', i18nKey: 'nav-gallery', label: 'Galeria' },
    { href: '/wspolprace', i18nKey: 'nav-collabs', label: 'Współprace' },
    { href: '/faq', i18nKey: 'nav-faq', label: 'FAQ' },
];
---
<BaseLayout
    title="Kolory Producentów – Guplos PL"
    description="Kolory Producentów – narzędzie z paletami kolorów marek."
    ogUrl="https://guplospl.com/narzedzia/kolory-producentow"
    navLinks={navLinks}
    activeNav="tools"
>
    <section class="flex-1 max-w-5xl mx-auto px-6 pt-28 pb-16 w-full">
        <h1 class="text-3xl md:text-4xl font-black tracking-tight text-center mb-6 fade-in" data-i18n="colors-title" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3), 0 0 60px rgba(255,255,255,0.15);">Kolory Producentów</h1>

        <div class="max-w-3xl mx-auto mb-6 fade-in">
            <div class="relative">
                <input id="search-input" type="text" class="w-full px-6 py-4 pr-14 rounded-2xl border text-lg outline-none transition-colors" data-i18n-placeholder="colors-search" placeholder="Szukaj koloru…" style="background: var(--card); border-color: var(--card-border); color: var(--text);">
                <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="color: var(--muted);"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
        </div>

        <div id="makes-bar" class="flex flex-wrap justify-center gap-2 mb-8 fade-in"></div>

        <div id="colors-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        <p id="empty-msg" class="text-center text-sm py-16" data-i18n="colors-pick" style="color: var(--muted-2);">Wybierz markę lub wpisz szukany kolor, aby zobaczyć kolory</p>
    </section>
</BaseLayout>

<script>
    import { initColors } from '../../lib/colors.js';
    initColors();
</script>
