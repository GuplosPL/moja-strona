---
import BaseLayout from '../../layouts/BaseLayout.astro';

const navLinks = [
    { href: '/', i18nKey: 'nav-home', label: 'Strona główna' },
    { href: '/#gallery', i18nKey: 'nav-gallery', label: 'Galeria' },
    { href: '/faq', i18nKey: 'nav-faq', label: 'FAQ' },
];

const controls = [
    { id: 'editor-brightness', i18nKey: 'editor-brightness', label: 'Jasność', min: -100, max: 100, value: 0, tip: 'Rozjaśnia lub przyciemnia cały obraz' },
    { id: 'editor-contrast', i18nKey: 'editor-contrast', label: 'Kontrast', min: -100, max: 100, value: 0, tip: 'Różnica między ciemnymi i jasnymi obszarami' },
    { id: 'editor-saturation', i18nKey: 'editor-saturation', label: 'Nasycenie', min: -100, max: 100, value: 0, tip: 'Intensywność kolorów' },
    { id: 'editor-temperature', i18nKey: 'editor-temperature', label: 'Temperatura', min: -100, max: 100, value: 0, tip: 'Cieplejsze lub chłodniejsze barwy' },
    { id: 'editor-sepia', i18nKey: 'editor-sepia', label: 'Sepia', min: 0, max: 100, value: 0, tip: 'Stary, brązowy styl fotografii' },
    { id: 'editor-sharpen', i18nKey: 'editor-sharpen', label: 'Ostrość', min: 0, max: 100, value: 0, tip: 'Wyostrza krawędzie i szczegóły' },
    { id: 'editor-vignette', i18nKey: 'editor-vignette', label: 'Winieta', min: 0, max: 100, value: 0, tip: 'Przyciemnia rogi zdjęcia' },
    { id: 'editor-grain', i18nKey: 'editor-grain', label: 'Ziarno', min: 0, max: 100, value: 0, tip: 'Dodaje filmowy szum' },
    { id: 'editor-blur', i18nKey: 'editor-blur', label: 'Rozmycie', min: 0, max: 30, value: 0, tip: 'Zmiękcza cały obraz' },
];

const presets = [
    { name: 'natural', label: 'Naturalny' },
    { name: 'warm', label: 'Ciepły' },
    { name: 'cool', label: 'Zimny' },
    { name: 'vivid', label: 'Żywy' },
    { name: 'film', label: 'Filmowy' },
    { name: 'soft', label: 'Miękki' },
];
---
<BaseLayout
    title="Edytor Obrazów – Guplos PL"
    description="Edytor obrazów online z podstawowymi regulacjami."
    ogUrl="https://moja-strona-yi0.pages.dev/narzedzia/edytor-obrazow"
    navLinks={navLinks}
    activeNav="tools"
>
    <section class="flex-1 w-full px-6 pt-28 pb-16">
        <h1 class="text-3xl md:text-4xl font-black tracking-tight text-center mb-8 fade-in" data-i18n="editor-title" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3), 0 0 60px rgba(255,255,255,0.15);">Edytor Obrazów</h1>

        <div id="editor-empty" class="max-w-2xl mx-auto fade-in">
            <div id="editor-drop" class="rounded-2xl border-2 border-dashed p-12 md:p-16 text-center cursor-pointer transition-colors drag:border-[#5865F2]" style="border-color: var(--card-border); background: var(--card);">
                <svg class="w-14 h-14 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" style="color: var(--muted);"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
                <p class="font-semibold mb-1" data-i18n="editor-upload" style="color: var(--text-bright);">Wybierz zdjęcie lub przeciągnij je tutaj</p>
                <p class="text-xs mb-6" style="color: var(--muted);" data-i18n="editor-upload-hint">PNG, JPG lub WEBP</p>
                <button id="editor-browse" class="px-6 py-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm rounded-full transition-colors" data-i18n="editor-browse">Przeglądaj</button>
                <input id="editor-file" type="file" accept="image/*" class="hidden">
            </div>
        </div>

        <div id="editor-box" class="hidden fade-in">
            <div class="flex flex-col lg:flex-row lg:items-start">
                <div class="flex-1 min-w-0 lg:pr-[21rem]">
                    <div id="editor-preview-wrap" class="relative mx-auto rounded-2xl overflow-hidden border max-w-[75%]" style="background: var(--card); border-color: var(--card-border);">
                        <canvas id="editor-canvas" class="w-full h-auto block"></canvas>
                        <span id="editor-filename" class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-medium max-w-[70%] truncate z-20" style="background: rgba(0,0,0,0.6); color: var(--text-bright);"></span>
                        <div id="crop-overlay" class="hidden absolute inset-0 z-30">
                            <div class="crop-shade absolute" style="top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.55);"></div>
                            <div id="crop-box" class="absolute border-2 cursor-move" style="border-color:#5865F2;box-shadow:0 0 0 9999px rgba(0,0,0,0.55);">
                                <span class="crop-handle" data-h="nw" style="top:-8px;left:-8px;"></span>
                                <span class="crop-handle" data-h="n" style="top:-8px;left:calc(50% - 8px);"></span>
                                <span class="crop-handle" data-h="ne" style="top:-8px;right:-8px;"></span>
                                <span class="crop-handle" data-h="e" style="top:calc(50% - 8px);right:-8px;"></span>
                                <span class="crop-handle" data-h="se" style="bottom:-8px;right:-8px;"></span>
                                <span class="crop-handle" data-h="s" style="bottom:-8px;left:calc(50% - 8px);"></span>
                                <span class="crop-handle" data-h="sw" style="bottom:-8px;left:-8px;"></span>
                                <span class="crop-handle" data-h="w" style="top:calc(50% - 8px);left:-8px;"></span>
                                <div class="crop-action absolute -bottom-12 right-0 flex gap-2">
                                    <button id="crop-apply" class="px-4 py-1.5 bg-[#5865F2] text-white text-xs font-semibold rounded-full" data-i18n="editor-crop-apply">Zastosuj</button>
                                    <button id="crop-cancel" class="px-4 py-1.5 bg-black/60 text-white text-xs font-semibold rounded-full" data-i18n="editor-crop-cancel">Anuluj</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-3 mt-5">
                        <button id="editor-before" class="px-5 py-2 text-sm font-semibold rounded-full border transition-colors" style="color: var(--text-bright); background: var(--card); border-color: var(--card-border);" data-i18n="editor-before">Przed</button>
                        <button id="editor-flip-h" class="px-5 py-2 text-sm font-semibold rounded-full border transition-colors" style="color: var(--text); background: var(--card); border-color: var(--card-border);" data-i18n="editor-flip-h">Poziomo</button>
                        <button id="editor-flip-v" class="px-5 py-2 text-sm font-semibold rounded-full border transition-colors" style="color: var(--text); background: var(--card); border-color: var(--card-border);" data-i18n="editor-flip-v">Pionowo</button>
                        <button id="editor-crop" class="px-5 py-2 text-sm font-semibold rounded-full border transition-colors" style="color: var(--text); background: var(--card); border-color: var(--card-border);" data-i18n="editor-crop">Kadruj</button>
                        <button id="editor-reset" class="px-5 py-2 text-sm font-semibold rounded-full border transition-colors" style="color: var(--text); background: var(--card); border-color: var(--card-border);" data-i18n="editor-reset">Resetuj</button>
                        <button id="editor-export" class="px-6 py-2 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm rounded-full transition-colors" data-i18n="editor-export">Pobierz</button>
                    </div>
                    <div class="flex flex-wrap items-center gap-4 mt-4">
                        <label class="text-xs font-medium" data-i18n="editor-format" style="color: var(--muted);">Format</label>
                        <select id="editor-format" class="text-xs font-semibold rounded-full border px-3 py-1.5" style="color: var(--text); background: var(--card); border-color: var(--card-border);">
                            <option value="png">PNG</option>
                            <option value="jpeg">JPG</option>
                            <option value="webp">WEBP</option>
                        </select>
                        <label class="text-xs font-medium ml-2" data-i18n="editor-quality" style="color: var(--muted);">Jakość</label>
                        <span id="editor-quality-value" class="text-xs tabular-nums" style="color: var(--muted);">92</span>
                        <input id="editor-quality" type="range" min="10" max="100" value="92" class="w-32 editor-range">
                    </div>
                </div>

                <div class="lg:fixed lg:right-0 lg:top-20 lg:w-80 lg:pr-6">
                    <div class="rounded-2xl border p-4" style="background: var(--card); border-color: var(--card-border);">
                        <p class="text-xs font-semibold uppercase tracking-wider mb-2.5" data-i18n="editor-presets" style="color: var(--muted);">Presety</p>
                        <div class="flex flex-wrap gap-1.5 mb-4">
                            {presets.map(p => (
                                <button data-preset={p.name} class="preset-btn px-3 py-1 text-xs font-semibold rounded-full border transition-all hover:scale-105" style="color: var(--text); background: var(--card-hover); border-color: var(--card-border);">{p.label}</button>
                            ))}
                        </div>
                        <div class="space-y-3.5">
                            {controls.map(c => (
                                <div class="relative editor-control" title={c.tip}>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="text-xs font-medium" data-i18n={c.i18nKey} style="color: var(--text);">{c.label}</label>
                                        <span id={`${c.id}-value`} class="text-xs tabular-nums" style="color: var(--muted);">{c.value}</span>
                                    </div>
                                    <input id={c.id} type="range" min={c.min} max={c.max} value={c.value} class="w-full editor-range">
                                    <span class="editor-tooltip">{c.tip}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .editor-range { appearance: none; -webkit-appearance: none; height: 4px; border-radius: 999px; background: var(--card-border); outline: none; cursor: pointer; }
    .editor-range::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%; background: #5865F2; border: 2px solid #fff; box-shadow: 0 0 8px rgba(88,101,242,0.6); cursor: pointer; }
    .editor-range::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: #5865F2; border: 2px solid #fff; box-shadow: 0 0 8px rgba(88,101,242,0.6); cursor: pointer; }
    #editor-drop.drag { border-color: #5865F2 !important; background: rgba(88,101,242,0.08); }
    .editor-tooltip { position: absolute; bottom: 100%; left: 0; transform: translateY(4px); padding: 4px 8px; border-radius: 6px; background: #1f1f1f; color: #fff; font-size: 11px; line-height: 1.3; white-space: normal; max-width: 220px; z-index: 50; opacity: 0; pointer-events: none; transition: opacity 0.15s ease, transform 0.15s ease; }
    .editor-control:hover .editor-tooltip { opacity: 1; transform: translateY(0); }
    .crop-handle { position: absolute; width: 16px; height: 16px; border-radius: 50%; background: #5865F2; border: 2px solid #fff; cursor: pointer; z-index: 40; }
    .crop-handle[data-h="n"], .crop-handle[data-h="s"] { cursor: ns-resize; }
    .crop-handle[data-h="e"], .crop-handle[data-h="w"] { cursor: ew-resize; }
    .crop-handle[data-h="ne"], .crop-handle[data-h="sw"] { cursor: nesw-resize; }
    .crop-handle[data-h="nw"], .crop-handle[data-h="se"] { cursor: nwse-resize; }
    .crop-action { z-index: 45; }
</style>

<script>
    import { initEditor } from '../../lib/editor.js';
    initEditor();
</script>
