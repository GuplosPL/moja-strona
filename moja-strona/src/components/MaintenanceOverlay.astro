---
import { MAINTENANCE } from '../lib/maintenance.js';
---
{MAINTENANCE && (
    <div id="maintenance" class="fixed inset-0 z-[400] flex flex-col items-center justify-center px-6 text-center" style="background: var(--bg); color: var(--text);">
        <div class="fixed inset-0 z-0 pointer-events-none" style="background: radial-gradient(1000px 650px at 100% -10%, rgba(88,101,242,0.14), transparent 60%), radial-gradient(900px 600px at -10% 110%, rgba(88,101,242,0.08), transparent 60%);"></div>
        <div class="relative z-10 w-full max-w-md">
            <p class="font-extrabold text-lg tracking-tight mb-8" style="color: var(--text-bright); text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3), 0 0 60px rgba(255,255,255,0.15);">#GOODDAYS</p>
            <div class="rounded-2xl border p-8" style="background: var(--card); border-color: var(--card-border);">
                <div class="w-14 h-14 mx-auto mb-5 rounded-full flex items-center justify-center" style="background: #f0b232/15;">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="#f0b232" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/></svg>
                </div>
                <h1 class="text-2xl font-bold tracking-tight mb-3" style="color: var(--text-bright);" data-i18n="maintenance-title">Przerwa techniczna</h1>
                <p class="text-sm leading-relaxed mb-6" style="color: var(--muted);" data-i18n="maintenance-text">Strona jest chwilowo niedostępna z powodu przerwy technicznej. Pracujemy nad przywróceniem usług — sprawdź status strony, aby śledzić postęp prac.</p>
                <a href="/status" class="inline-block w-full px-5 py-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm rounded-full transition-colors no-underline" data-i18n="maintenance-status">Sprawdź status strony</a>
            </div>
        </div>
    </div>
)}
