---
const now = new Date();
const isDecember = now.getMonth() === 11;
---
<div id="cookie-banner" class="fixed bottom-4 left-4 right-4 z-[300] fade-in" style="display: none;">
    <div class="rounded-2xl border p-5 shadow-2xl mx-auto max-w-md" style="background: var(--bg-elev); border-color: var(--card-border); box-shadow: 0 20px 60px rgba(0,0,0,0.5);">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(88,101,242,0.15);">
                <svg width="18" height="18" fill="none" stroke="#5865F2" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15.546c-.523 0-1.046.151-1.5.423a7.5 7.5 0 01-2.896 1.517 7.5 7.5 0 01-2.667.01 7.5 7.5 0 01-2.735-1.465 7.5 7.5 0 01-1.186-1.233 7.5 7.5 0 01-1.517-2.896 7.5 7.5 0 01-.01-2.667 7.5 7.5 0 011.465-2.735 7.5 7.5 0 011.233-1.186A7.5 7.5 0 016.334 3.05 7.5 7.5 0 019.29 2.54 7.5 7.5 0 0112 2.25v5.25a4.5 4.5 0 004.5 4.5h5.25c0 .777-.058 1.549-.17 2.306a7.5 7.5 0 01-1.93 3.74.75.75 0 00.35 1.5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M20.625 16.5a1.875 1.875 0 100-3.75 1.875 1.875 0 000 3.75z"/></svg>
            </div>
            <p class="text-sm font-bold" style="color: var(--text-bright);">Cookies</p>
        </div>
        <p class="text-sm leading-relaxed mb-4" data-i18n="cookie-text" style="color: var(--muted);"></p>
        <div class="flex flex-col sm:flex-row gap-2">
            <button id="cookie-accept" class="flex-1 px-4 py-2.5 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm rounded-full transition-colors" data-i18n="cookie-accept"></button>
            <button id="cookie-decline" class="flex-1 px-4 py-2.5 font-semibold text-sm rounded-full border transition-colors" style="color: var(--text); background: var(--card); border-color: var(--card-border);" data-i18n="cookie-decline"></button>
        </div>
        {isDecember && <p class="mt-3 text-xs" style="color: var(--muted-2);">❄️</p>}
    </div>
</div>

<script>
    import { store } from '../lib/store.js';
    const banner = document.getElementById('cookie-banner');
    const consent = store.get('cookie-consent');
    if (!consent) {
        banner.style.display = 'block';
        requestAnimationFrame(() => {
            setTimeout(() => banner.classList.add('visible'), 50);
        });
    }
    function close() {
        banner.classList.remove('visible');
        setTimeout(() => banner.style.display = 'none', 500);
    }
    document.getElementById('cookie-accept').addEventListener('click', () => { store.set('cookie-consent', 'accepted'); close(); });
    document.getElementById('cookie-decline').addEventListener('click', () => { store.set('cookie-consent', 'declined'); close(); });
</script>
